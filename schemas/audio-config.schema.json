{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaelfernandez1/KaraokeProject/schemas/audio-config.schema.json",
  "$defs": {
    "Route": {
      "additionalProperties": false,
      "properties": {
        "track": {
          "enum": [
            "vocals",
            "instrumental"
          ],
          "type": "string"
        },
        "output": {
          "description": "An audio device id.",
          "minLength": 1,
          "type": "string"
        },
        "gain_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.0,
          "description": "None mutes the route."
        },
        "delay_ms": {
          "default": 0.0,
          "maximum": 2000,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "track",
        "output",
        "gain_db",
        "delay_ms"
      ],
      "title": "Route",
      "type": "object"
    },
    "Routing": {
      "additionalProperties": false,
      "properties": {
        "master": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audio device whose clock rules."
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/Route"
          },
          "type": "array"
        },
        "policies": {
          "additionalProperties": {
            "enum": [
              "pause",
              "continue"
            ],
            "type": "string"
          },
          "description": "What happens when an output disappears; default: pause if it is the master, continue otherwise.",
          "type": "object"
        }
      },
      "required": [
        "master",
        "routes",
        "policies"
      ],
      "title": "Routing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "How `kp-audio` sends the stems to the backend's sound cards.",
  "properties": {
    "routing": {
      "$ref": "#/$defs/Routing"
    },
    "calibration_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Per stable device id: how late it really is, beyond what the OS reports.",
      "type": "object"
    }
  },
  "required": [
    "routing",
    "calibration_ms"
  ],
  "title": "AudioConfig",
  "type": "object"
}
