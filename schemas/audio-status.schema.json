{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaelfernandez1/KaraokeProject/schemas/audio-status.schema.json",
  "$defs": {
    "AudioDevice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable across reboots.",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "channels": {
          "default": 2,
          "minimum": 1,
          "type": "integer"
        },
        "sample_rate": {
          "default": 48000,
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default": {
          "type": "boolean",
          "default": false
        },
        "connected": {
          "default": true,
          "type": "boolean"
        },
        "bluetooth": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "channels",
        "sample_rate",
        "latency_ms",
        "default",
        "connected",
        "bluetooth"
      ],
      "title": "AudioDevice",
      "type": "object"
    },
    "AudioError": {
      "additionalProperties": false,
      "description": "Something the audio engine could not do, until it can again.",
      "properties": {
        "code": {
          "enum": [
            "output_failed",
            "output_lost",
            "load_failed",
            "master_lost"
          ],
          "type": "string"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The audio device id."
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "device",
        "item_id",
        "message"
      ],
      "title": "AudioError",
      "type": "object"
    },
    "ContentCache": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
          "type": "string"
        },
        "manifest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "state": {
          "enum": [
            "absent",
            "downloading",
            "verifying",
            "ready",
            "failed"
          ],
          "type": "string"
        },
        "fraction": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "content_id",
        "manifest",
        "state",
        "fraction",
        "error"
      ],
      "title": "ContentCache",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What `kp-audio` reports every second and on every change.",
  "properties": {
    "state": {
      "default": "idle",
      "enum": [
        "idle",
        "loading",
        "ready",
        "playing",
        "paused"
      ],
      "type": "string"
    },
    "epoch": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ready": {
      "default": false,
      "description": "The cued song is decoded and primed.",
      "type": "boolean"
    },
    "item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "position": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/AudioError"
      },
      "type": "array"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/AudioDevice"
      },
      "type": "array"
    },
    "cache": {
      "items": {
        "$ref": "#/$defs/ContentCache"
      },
      "type": "array"
    },
    "sync": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Diagnostics: measured drift (ppm) and offsets (ms).",
      "type": "object"
    }
  },
  "required": [
    "state",
    "epoch",
    "ready",
    "item_id",
    "position",
    "errors",
    "devices",
    "cache",
    "sync"
  ],
  "title": "AudioStatus",
  "type": "object"
}
